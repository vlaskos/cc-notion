# cc-notion install config — copy this file to install.env and edit it.
# install.env is gitignored, so your host-specific values and IDs stay local
# and are not reset when you re-run ./install.sh.
#
# All values are optional except NGROK_DOMAIN.

# Your ngrok reserved/static domain (from the ngrok dashboard).
NGROK_DOMAIN=your-domain.ngrok-free.app

# Your Notion person-id — the owner, always allowed to trigger /cc.
# Add other people in data/allowlist.txt instead of here.
NOTION_USER_ID=

# Tools the headless `claude -p` session may use (comma-separated).
# Match your Notion MCP prefix: mcp__notion (self-hosted) or
# mcp__claude_ai_Notion (Claude's managed connector). Append WebSearch and
# mcp__content-core__extract_content to give the bot web access.
ALLOWED_TOOLS=mcp__notion
